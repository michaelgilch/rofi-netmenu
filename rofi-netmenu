#!/bin/bash
# rofi-netmenu: rofi menus for network connections. Each lib/*.sh file other
# than netmenu-lib.sh is a backend (ethernet, Wi-Fi, openfortivpn, Tailscale,
# ...) that registers itself when sourced.
#
# Usage: rofi-netmenu [backend]

set -o pipefail

usage() {
    local names=() i
    for i in "${backend_idx[@]}"; do
        names+=("${_backend_names[i]}")
    done
    local IFS='|'
    echo "Usage: ${0##*/} [${names[*]}]" >&2
    exit 2
}

# The library sits next to the script in the working tree (and under `make
# link`, which symlinks the script), or in $PREFIX/lib/rofi-netmenu once
# installed.
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
for libdir in "$here/lib" "$here/../lib/rofi-netmenu"; do
    [[ -f $libdir/netmenu-lib.sh ]] && break
done
if [[ ! -f $libdir/netmenu-lib.sh ]]; then
    echo "${0##*/}: helper library not found" >&2
    exit 1
fi

# shellcheck source=lib/netmenu-lib.sh
source "$libdir/netmenu-lib.sh"

# The config is loaded before the backends so they can set their own defaults
# from it when sourced.
config="${XDG_CONFIG_HOME:-$HOME/.config}/rofi-netmenu/config"
# shellcheck source=/dev/null
[[ -f $config ]] && source "$config"

TERMINAL="${TERMINAL:-kitty}"
read -ra rofi_args <<< "${ROFI_ARGS:-}"

for lib in "$libdir"/*.sh; do
    [[ $lib == */netmenu-lib.sh ]] && continue
    # shellcheck source=/dev/null
    source "$lib"
done
mapfile -t backend_idx < <(backend_indexes)

# Entries for unavailable backends (no device, no FORTI_HOST, no tailscale)
# are left out. Row keys are registry indexes.
top_menu() {
    local key i
    while :; do
        menu_reset
        for i in "${backend_idx[@]}"; do
            "${_backend_prefixes[i]}_available" &&
                row "$i" "${_backend_labels[i]}" "${_backend_icons[i]}"
        done
        if ((${#_keys[@]} == 0)); then
            notify "rofi-netmenu" "Nothing to manage: no backend is available"
            exit 0
        fi
        key=$(menu "Network") || exit 0
        "${_backend_prefixes[key]}_menu" back
    done
}

case ${1:-} in
"") top_menu ;;
# "name<TAB>label<TAB>icon" per backend, for generating launcher entries.
--list)
    for i in "${backend_idx[@]}"; do
        printf '%s\t%s\t%s\n' "${_backend_names[i]}" "${_backend_labels[i]}" \
            "${_backend_icons[i]}"
    done
    exit 0
    ;;
esac
for i in "${backend_idx[@]}"; do
    if [[ ${_backend_names[i]} == "$1" ]]; then
        "${_backend_prefixes[i]}_menu"
        exit 0
    fi
done
usage
